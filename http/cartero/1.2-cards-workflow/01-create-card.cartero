version = 1
url = "{{BASE_URL}}/api/v1/boards/{{BOARD_ID}}/columns/{{COLUMN_ID}}/cards"
method = "POST"
body = "title=Preparar+material&description=Primer+exemple"

[variables]
BASE_URL = "http://127.0.0.1:8080"
BOARD_ID = "REEMPLAZAR_CON_ID_REAL"
COLUMN_ID = "REEMPLAZAR_CON_ID_REAL"
CSRF_TOKEN = "REEMPLAZAR_EN_MEMORIA_SIN_GUARDAR"

[headers]
Accept = "application/json"
Content-Type = "application/x-www-form-urlencoded"
X-CSRF-Token = "{{CSRF_TOKEN}}"
Sec-Fetch-Site = "same-origin"
