version = 1
url = "{{BASE_URL}}/api/v1/boards/999/cards/999"
method = "PATCH"
body = "title=Intrusi%C3%B3n&description="

[variables]
BASE_URL = "http://127.0.0.1:8080"
CSRF_TOKEN = "REEMPLAZAR_EN_MEMORIA_SIN_GUARDAR"

[headers]
Accept = "application/json"
Content-Type = "application/x-www-form-urlencoded"
X-CSRF-Token = "{{CSRF_TOKEN}}"
Sec-Fetch-Site = "same-origin"
