version = 1
url = "{{BASE_URL}}/api/v1/boards/{{BOARD_ID}}/columns/{{COLUMN_ID}}/cards"
method = "POST"
body = "title=Test&description="

[variables]
BASE_URL = "http://127.0.0.1:8080"
BOARD_ID = "REEMPLAZAR_CON_ID_REAL"
COLUMN_ID = "REEMPLAZAR_CON_ID_REAL"

[headers]
Accept = "application/json"
Content-Type = "application/x-www-form-urlencoded"
X-CSRF-Token = "TOKEN_INVALIDO_XXXXXXXXXXXXXXXXXXXXXXXXXXX"
Sec-Fetch-Site = "same-origin"
