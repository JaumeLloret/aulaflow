<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>es.aulaflow</groupId>
    <artifactId>aulaflow</artifactId>
    <version>1.0.0</version>

    <name>AulaFlow</name>

    <description>
        Gestor Kanban educativo desarrollado con Java 26.
    </description>

    <properties>
        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

        <maven.compiler.release>26</maven.compiler.release>

        <junit.version>5.14.4</junit.version>

        <maven.compiler.plugin.version>
            3.15.0
        </maven.compiler.plugin.version>

        <maven.surefire.plugin.version>
            3.5.5
        </maven.surefire.plugin.version>

        <maven.enforcer.plugin.version>
            3.6.3
        </maven.enforcer.plugin.version>

        <maven.shade.plugin.version>
            3.6.2
        </maven.shade.plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>
                    ${maven.compiler.plugin.version}
                </version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>
                    ${maven.surefire.plugin.version}
                </version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>
                    ${maven.enforcer.plugin.version}
                </version>

                <executions>
                    <execution>
                        <id>enforce-build-environment</id>

                        <goals>
                            <goal>enforce</goal>
                        </goals>

                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[26,27)</version>

                                    <message>
                                        AulaFlow 1.0 debe compilarse
                                        utilizando JDK 26.
                                    </message>
                                </requireJavaVersion>

                                <requireMavenVersion>
                                    <version>[3.9.0,4.0.0)</version>

                                    <message>
                                        AulaFlow requiere una versión
                                        de Maven 3.9 o posterior.
                                        Utiliza Maven Wrapper.
                                    </message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>
                                false
                            </createDependencyReducedPom>

                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>
                                        es.aulaflow.AulaFlowApplication
                                    </mainClass>

                                    <manifestEntries>
                                        <Enable-Native-Access>
                                            ALL-UNNAMED
                                        </Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
